  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>3. Combate</b>\r\nO combate acontece de 2 formas diferentes: a cada
    3 rodadas a Arena \xE9 ativa, onde todos os jogadores devem batalhar, ou quando
    um jogador cai na casa em que outro jogador est\xE1, um combate \xE9 baseado
    nos atributos que cada personagem tem,  \n       <color=#FFD900>Ataque</color>,        
    <color=#00C8FF>Defesa</color> e   \n         <color=#FF1111>Vida</color>.\r\nAmbos
    os jogadores causam dano simultaneamente\n\r\n<b>4. Arena</b>\r\nDurante a <b>Arena</b>,
    cada jogador ataca anonimamente um outro.\r\n    \u2022  Todos escolhem um alvo\r\n   
    \u2022  As escolhas s\xE3o reveladas\r\n    \u2022  Os combates acontecem simultaneamente,
    seguindo as regras estabelecidas anteriormente."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: faa4c391776212848a5e6cc097d5b603, type: 2}
